# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Explicit line endings for Windows scripts.
*.bat text eol=crlf
*.ps1 text eol=lf

# Properly detect languages on Github.
*.h linguist-language=C++

# Git LFS tracking for Godot binary files.
*.mesh filter=lfs diff=lfs merge=lfs -text
*.res filter=lfs diff=lfs merge=lfs -text
*.scn filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for audio files.
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.opus filter=lfs diff=lfs merge=lfs -text
*.qoa filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for image files.
*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.qoi filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for model files.
*.bin filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.g4b filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for video files.
*.ogv filter=lfs diff=lfs merge=lfs -text
