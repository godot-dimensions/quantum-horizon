var _stage: Node4D
var _caption: Node
var _show: Node
var _presenter: Node4D
var _table: Node4D
var _panels: Array[MeshInstance4D] = []

var _running: bool = false
var _moment: int = -1
var _phase: float = 0.0
var _pieces: Array[Node4D] = []
var _goat: Node4D
var _creature: Node4D
var _camera: Node
var _told: int = 0
var _metrics: Node
var _turned: bool = false
var _done: bool = false
var _lent_back: bool = false


func _ready() -> void:
	_stage = get_node_or_null(stage_path) as Node4D
	_caption = get_node_or_null(caption_path)
	_show = get_node_or_null(show_path)
	_presenter = get_node_or_null(presenter_path) as Node4D
	_metrics = get_node_or_null(metrics_path)
	_camera = get_node_or_null(camera_path)
	if _stage == null:
		push_warning("TheatrePartTwo: no stage, so there is nowhere to put any of this.")
		return
	_table = _stage.get_node_or_null("Turntable") as Node4D
	for panel in (_stage.get_node_or_null("Backdrop").get_children()
			if _stage.get_node_or_null("Backdrop") != null else []):
		if panel is MeshInstance4D:
			_panels.append(panel)
	# NOT BUILT HERE ANY MORE. See the header on _pump_build: this was 3.5 of the 3.9
	# seconds it cost to walk through the door.
	#
	# BUT THEIR SCENES START LOADING NOW, on a thread. The goat and the creature are adopted
	# out of two Model scenes, and loading those off disk - every script they name, the
	# heron's and the owl's included - was 112 and 116 ms of the two exhibits' frames
	# (measured 10 Oct, _probe_adopt_cost_runner). Asked for here, they are long loaded by
	# the time the exhibits are built.
	for path in [GOAT.SOURCE, CREATURE.SOURCE]:
		if ResourceLoader.load_threaded_request(path) == OK:
			_requested.append(path)


## Called by the show the moment slide I ends, by the clock or by a click.
func begin() -> void:
	finish_building()
	if _running or _done:
		return
	_running = true
	_done = true
	_enter(0)


func is_running() -> bool:
	return _running


## Back to before its first slide, for a second showing (theatre_show_4d.replay). The
## exhibits stay built; they are only taken off the drum.
func reset() -> void:
	_running = false
	_done = false
	_lent_back = false
	_moment = -1
	_phase = 0.0
	_told = 0
	_show_piece(-1)
	if _show != null and _show.has_method("hold_at"):
		_show.call("hold_at", -1)
	if _metrics != null and _metrics.has_method("clear"):
		_metrics.call("clear")


func current_moment() -> int:
	return _moment


## LEFT MOUSE FORWARD, ARROWS EITHER WAY. The clock still runs underneath - stand still
## and it plays itself - but a presentation you cannot skip or go back in is a video, and
## the one thing an audience always wants is the slide they just missed.
func _unhandled_input(event: InputEvent) -> void:
	if not _running or _lent_back:
		return
	var step := 0
	var click := event as InputEventMouseButton
	if click != null and click.pressed and click.button_index == MOUSE_BUTTON_LEFT:
		step = 1
	var key := event as InputEventKey
	if key != null and key.pressed and not key.echo:
		if key.keycode == KEY_RIGHT:
			step = 1
		elif key.keycode == KEY_LEFT:
			step = -1
	if step == 0:
		return
	get_viewport().set_input_as_handled()
	# FORWARD OFF THE END FINISHES IT. Part one had this bug and it is the same one here:
	# _enter resets the phase clock, and stepping forward while already on the closing
	# beat clamps to the same index and re-enters it, so every click restarts the seconds
	# the ending is waiting on - and the ending is what stands you out of the chair.
	#
	# AND IT IS LEAVING, not just the clock running out early. Ramon, 1 Oct: forward on
	# the outro "should also just kick you out of the presentation". It used to stand you
	# up with the closing line and the last exhibit still up behind you; now it is the
	# same as F or Escape in the chair (theatre_show_4d.walk_out), which clears the floor
	# and the caption as it lets you go.
	if step > 0 and _moment >= MOMENTS.size():
		_running = false
		if _show != null and _show.has_method("walk_out"):
			_show.call("walk_out")
		else:
			_finish()
		return
	# BACKWARD OFF THE FRONT GOES BACK TO SLIDE VI. From the audience there is one
	# presentation, not two, and a back arrow that does nothing on slide VII reads as the
	# controls having stopped working - which is exactly what an audience concludes the
	# moment a key stops responding. The seam between the two nodes is ours, not theirs.
	if step < 0 and _moment == 0 and _show != null 			and _show.has_method("step_back_from_part_two"):
		lend_back()
		_show.call("step_back_from_part_two")
		return
	_enter(clampi(_moment + step, 0, MOMENTS.size()))


## Part one has the floor for a moment. The clock stops, the input goes quiet, and the
## exhibits come off the drum - without that last part, slide VI's gloves would turn with
## the goat still standing behind them.
func lend_back() -> void:
	if _lent_back:
		return
	_lent_back = true
	_show_piece(-1)
	if _show != null and _show.has_method("hold_at"):
		_show.call("hold_at", -1)


## And taking it back, on the next forward step. Re-entering moment 0 rather than resuming
## mid-slide, because a slide you stepped away from and came back to should start again -
## its exhibit animates, and rejoining it half way through shows you the end of something
## you never saw the start of.
func resume() -> void:
	if not _lent_back:
		return
	_lent_back = false
	# PART ONE'S STAGE IS CLEARED FIRST. lend_back took this room's exhibits off the drum
	# on the way out; this is the other half of that, and it was missing. Part one put its
	# last finding back up when it was handed the floor - the mined rock - and it was
	# still standing there when we took the floor back, so every slide from here on was
	# played through the middle of it.
	if _show != null and _show.has_method("clear_stage"):
		_show.call("clear_stage")
	_enter(0)


func is_lent_back() -> bool:
	return _lent_back


## The end of it: stop the clock, hand the presenter back, and let them out of the chair.
## Ending the show while still holding the camera and the player's legs is a room that
## will not let you leave.
func _finish() -> void:
	if not _running:
		return
	_running = false
	if _show != null and _show.has_method("hold_at"):
		_show.call("hold_at", -1)
	if _show != null and _show.has_method("let_them_go"):
		_show.call("let_them_go")


## How long a moment runs. Most take the shared pace; the walking creature asks for
## half again, because it has three things to show in sequence and hurrying any one of
## them turns the slide into a flicker.
func _length(which: int) -> float:
	if which < 0 or which >= MOMENTS.size():
		return moment_seconds
	return moment_seconds * float(MOMENTS[which].get("pace", 1.0))


func _process(delta: float) -> void:
	# Before the early return, because the exhibits are built while part ONE is running
	# and this node is not.
	if _built < BUILDERS.size():
		_pump_build(delta)
	if not _running or _lent_back or _stage == null:
		return
	_phase += delta
	if _moment >= 0 and _moment < MOMENTS.size() and _phase >= _length(_moment):
		_enter(_moment + 1)
	elif _moment == MOMENTS.size() and _phase >= closing_seconds:
		_finish()
		return
	if _moment >= 0 and _moment < MOMENTS.size():
		_later(_moment, _phase)
		_demonstrate(_moment, _phase)


## Figures that change part way through a moment, because the thing they measure does.
## Issued once each - `_told` counts how many of this moment's later beats have gone - so
## a step backward and forward through a slide cannot double-issue one.
func _later(which: int, t: float) -> void:
	var beats: Array = MOMENTS[which].get("later", [])
	while _told < beats.size() and t >= float(beats[_told]["at"]) * _length(which):
		_issue(beats[_told]["metrics"] as Array)
		_told += 1


func _enter(which: int) -> void:
	_moment = which
	_phase = 0.0
	_told = 0
	_show_piece(which)
	if _camera != null and _camera.has_method("shoot"):
		_camera.call("shoot",
			String(MOMENTS[which].get("shot", "house")) if which < MOMENTS.size() else "house",
			_length(which) if which < MOMENTS.size() else closing_seconds)
	# Square again, or the next slide inherits a rotation it never asked for.
	for piece in _pieces:
		piece.basis = Basis4D.from_zx(0.0)
	# AT THE DRUM FOR ANYTHING HE CAN STAND BESIDE, out front for anything else. The goat
	# and the walking creature (pieces 0 and 1) are both things he stands beside, so on
	# every slide here he is in on the drum, and out front only for the closing line. The
	# rule is what he can stand BESIDE, not which slide it is.
	if _show != null and _show.has_method("hold_at"):
		var beside: bool = which < MOMENTS.size() \
			and int(MOMENTS[which].get("piece", which)) in [0, 1]
		_show.call("hold_at", 1 if beside else 0)
	# Still for everything that is a comparison; turning for the goat on slide VII, which is
	# one object and wants to be seen from more than one side.
	if _show != null and _show.has_method("set_spin"):
		_show.call("set_spin", which == 0)
	if which < MOMENTS.size():
		var m: Dictionary = MOMENTS[which]
		_say(String(m["title"]), _fill(String(m["body"])), _fill(String(m["figure"])),
			String(m["tier"]))
		_tint(m["tint"])
		_issue(m["metrics"] as Array)
		# Back off the closing line onto a slide: the end is not the end any more.
		if _show != null and _show.has_method("uncurtain"):
			_show.call("uncurtain")
	else:
		if _metrics != null and _metrics.has_method("clear"):
			_metrics.call("clear")
		_say("", "That is the case as it stands, gaps included. The rest is somebody else's decision, which is the correct place for it to be.", "", "")
		_tint(Color(0.10, 0.12, 0.20))
		# The house lights, the bow and the card: theatre_show_4d.curtain.
		if _show != null and _show.has_method("curtain"):
			_show.call("curtain")


## The goat's figures are whatever the goat actually came out at. Writing them into the
## caption by hand meant they were wrong within an hour of the first time its proportions
## were adjusted - the shape changed, the tetrahedron count changed with it, and the slide
## went on claiming the old number. The room measures its own exhibit.
func _fill(text: String) -> String:
	var out: String = text
	if _goat != null:
		var balls: int = int(_goat.call("ball_count"))
		var tetra: int = int(_goat.call("tetra_count"))
		out = out.replace("{balls}", str(balls)).replace("{tetra}", str(tetra)) \
			.replace("{each}", str(tetra / maxi(balls, 1)))
	if _creature != null:
		out = out.replace("{legs}", str(int(_creature.call("leg_count")))) \
			.replace("{segments}", str(int(_creature.call("segment_count")))) \
			.replace("{handles}", str(int(_creature.call("ball_count")))) \
			.replace("{gaits}", str(int(_creature.call("gait_count")))) \
			.replace("{creature_tetra}", _grouped(int(_creature.call("tetra_count"))))
	return out


## Twenty thousand tetrahedra written as 20,160 rather than 20160. Five digits in a row is
## a serial number; the comma is what makes it a quantity.
func _grouped(value: int) -> String:
	var digits: String = str(value)
	var out: String = ""
	for i in digits.length():
		if i > 0 and (digits.length() - i) % 3 == 0:
			out += ","
		out += digits[i]
	return out


## Fills a moment's figures and puts them up. One path for the figures a moment opens with
## and the figures it changes to part way through, so the two cannot drift apart.
func _issue(metrics: Array) -> void:
	if _metrics == null or not _metrics.has_method("show_metrics"):
		return
	var filled: Array = []
	for metric in metrics:
		var copy: Dictionary = (metric as Dictionary).duplicate()
		copy["value"] = _fill(String(copy["value"]))
		filled.append(copy)
	_metrics.call("show_metrics", filled)


## Re-issues a moment's figures without changing anything else, for the one moment whose
## number is still moving while you look at it.
func _retell(which: int) -> void:
	if _metrics == null or not _metrics.has_method("show_metrics"):
		return
	var live: int = int(_goat.call("balls_shown")) if _goat != null else 0
	var filled: Array = []
	for metric in (MOMENTS[which]["metrics"] as Array):
		var copy: Dictionary = (metric as Dictionary).duplicate()
		copy["value"] = str(live)
		filled.append(copy)
	_metrics.call("show_metrics", filled, true)


## THE CONTROLS ARE ON SCREEN ON EVERY SLIDE, because a presentation you can step through
## is only worth having if somebody knows they can - and a line that appears on some
## slides and not others reads as the controls having stopped working. Part one names the
## string, so the two parts cannot drift apart.
func _say(title: String, body: String, figure: String, tier: String) -> void:
	if _caption != null and _caption.has_method("show_act"):
		_caption.call("show_act", title, body, figure, tier, SHOW.NAV)


func _tint(to: Color) -> void:
	for panel in _panels:
		var material: TetraMaterial4D = panel.material_override as TetraMaterial4D
		if material != null:
			material.albedo_color = to


# ---------------------------------------------------------------- the exhibits

## THE TWO EXHIBITS, ONE PER FRAME, STARTING A BEAT AFTER THE ROOM OPENS.
##
## WHY THIS WAS THE WHOLE PROBLEM. Walking through the sci-fi door cost about four seconds
## and this function was three and a half of them - measured child by child, 89% of the
## entire theatre. It ran in `_ready`, so it was paid on the frame the door was crossed,
## building the goat and the eight-legged creature, and then hiding both of them.
##
## Preloading could never have helped with that, which is the thing that made it look
## mysterious: the PackedScene is held as an exported reference and is already resident,
## so `load()` is a cache hit at 0.0 ms and `instantiate()` is 0.3. A scene file is a
## blueprint. All the cost is construction, and construction cannot start before you ask.
##
## SO IT IS ASKED FOR LATER, AND IN PIECES. The opening and slide I come first, and the
## player spends the opening walking down a ramp and being sat in a chair. One exhibit a
## frame across that window costs a frame of about a second each in a debug build - well
## under a frame in a real one - and the door itself drops to around 450 ms.
##
## ANYTHING THAT NEEDS THEM ALL CALLS finish_building() FIRST, which runs whatever is left
## on the spot. That is the safety net: the timing above has seconds of slack, but a slow
## machine, a paused tree or somebody hammering the arrow keys should not be able to get a
## half-built set on stage.
##
## AND THEY ARE BUILT ON THE STILL BEAT, right after part one's (theatre_show_4d's
## ACT_BUILDERS): the moment you land in the chair and the camera holds on you. They used to
## start 14 s after the room opened, which is the middle of slide I - the ball passing
## through the chicken's sheet, the one moment of the talk that is all motion. Since the
## goat and the creature are read from their bakes (theatre_bake_4d) and their scenes come
## in on a thread, they cost about 16 and 50 ms now, and on the still beat nobody sees it.
const BUILDERS: Array[StringName] = [&"_the_goat", &"_the_creature"]
## The latest the first one starts, after the room opens, for somebody who neither sits nor
## waits for the opening to run out. Normally they start as soon as part one's are made.
@export_range(0.0, 60.0, 0.5) var build_delay: float = 14.0
## Between one exhibit and the next.
@export_range(0.0, 20.0, 0.5) var build_gap: float = 0.3

var _built: int = 0
var _build_wait: float = -1.0
## The two scenes the exhibits are adopted from, held once their thread has loaded them so
## the adoption's own load() finds them already in memory.
var _sources: Array[Resource] = []
## Thread loads asked for and not yet collected: collected on the way out if nobody stayed
## long enough for the exhibits, so the loader is not left holding them.
var _requested: Array[String] = []
## The worker building the exhibits' draw buffers (see _warm), or -1.
var _warm_task: int = -1


## Is everything this half needs actually made? The exhibits AND the goat's lofts - the
## two appends finish in two frames and the goat takes another twelve after that.
func is_built() -> bool:
	if _built < BUILDERS.size():
		return false
	return _goat == null or not _goat.has_method("is_baked") or bool(_goat.call("is_baked"))


func _pump_build(delta: float) -> void:
	if _stage == null:
		return
	if _build_wait < 0.0:
		_build_wait = build_delay
	_build_wait -= delta
	# Straight after part one's exhibits, on the same still beat, or at the latest when the
	# delay runs out.
	if _show != null and _show.has_method("exhibits_built") and bool(_show.call("exhibits_built")):
		_build_wait = minf(_build_wait, 0.0)
	if _build_wait <= 0.0:
		_build_one()
		_build_wait = build_gap


func _build_one() -> void:
	# The scene it is adopted from: waits for its thread if that has not finished, which by
	# the still beat it always has.
	var source: String = GOAT.SOURCE if BUILDERS[_built] == &"_the_goat" else CREATURE.SOURCE
	if _requested.has(source):
		_requested.erase(source)
		var loaded: Resource = ResourceLoader.load_threaded_get(source)
		if loaded != null:
			_sources.append(loaded)
	var piece: Node4D = call(BUILDERS[_built]) as Node4D
	_built += 1
	if piece != null:
		_pieces.append(piece)
		# Parked as it is made, rather than built visible and hidden afterwards - otherwise
		# each one is on stage for the frame between being finished and the next one
		# starting.
		piece.visible = false
		piece.position = Vector4(0.0, -40.0, 0.0, 0.0)
	if _built == BUILDERS.size():
		_start_warming()


## THE FIRST DRAW IS THE EXPENSIVE ONE. A mesh's draw buffers are built the first time it is
## drawn, so the finished goat cost 54 ms on the frame VII began, the creature 62 on IX's,
## and each of the goat's twelve stages 16 to 58 ms as VIII played them, one every second
## and a half (measured 10 Oct). Built here instead, on a worker, while nobody is looking at
## any of them - the shapes of part one are done the same way (theatre_primer_4d).
func _start_warming() -> void:
	var meshes: Array = []
	if _goat != null:
		meshes.append_array(_goat.get("_baked"))
		meshes.append(_goat.get("_finished"))
	if _creature != null:
		for segment in _creature.get("_segments"):
			meshes.append((segment as MeshInstance4D).mesh)
	_warm_task = WorkerThreadPool.add_task(Bake.warm.bind(meshes), false, "theatre part two draw buffers")


## Waits for the draw buffers, before anything of part two is drawn. Free by then.
func _warmed() -> void:
	if _warm_task >= 0:
		WorkerThreadPool.wait_for_task_completion(_warm_task)
		_warm_task = -1


func _exit_tree() -> void:
	_warmed()
	for path in _requested:
		ResourceLoader.load_threaded_get(path)
	_requested.clear()


## Everything that is left, now. Cheap when the pump has already done it, which is the
## normal case.
func finish_building() -> void:
	while _built < BUILDERS.size():
		_build_one()
	# And the goat's own twelve lofts, which are the bulk of it and bake themselves one a
	# frame. Nothing may go on stage part assembled.
	if _goat != null and _goat.has_method("finish_baking"):
		_goat.call("finish_baking")

func _build() -> void:
	finish_building()
	for piece in _pieces:
		piece.visible = false
## One at a time, and the rest are not merely hidden but moved out of the way, so a turn of
## the slice cannot reveal the last exhibit standing behind this one. Two moments stand on
## the SAME exhibit - the goat is placed in one and reshaped in the next - so the moment
## names its piece rather than the index being assumed to be it.
func _show_piece(which: int) -> void:
	_warmed()
	var wanted: int = -1
	if which >= 0 and which < MOMENTS.size():
		wanted = int(MOMENTS[which].get("piece", which))
	for i in _pieces.size():
		var on: bool = i == wanted
		_pieces[i].visible = on
		_pieces[i].position = Vector4(0.0, 0.0 if on else -40.0, 0.0, 0.0)
	if _goat != null and _goat.has_method("set_markers_visible"):
		_goat.call("set_markers_visible", which == 0)
	if _goat != null:
		# Slide VII wants the finished animal in its own colours; slide VIII starts it from
		# nothing and plain, so the geometry is the thing being looked at.
		if which == 1:
			_goat.call("show_stage", 0)
		else:
			_goat.call("show_finished")
	# Back to a dressed creature walking, whichever slide this is and whichever direction
	# it was arrived from. Stepping backward out of the walk half way through used to leave
	# a skinless animal cantering behind the next exhibit.
	if _creature != null:
		_creature.call("show_rig", false)
		_creature.call("set_gait", "walk")


## THE WALKING CREATURE. A moment says which piece it stands on by its index in
## BUILDERS, so reordering that list moves slides onto the wrong exhibit.
func _the_creature() -> Node4D:
	var piece := Node4D.new()
	piece.name = "CreatureStand"
	_table.add_child(piece)
	var beast := Node4D.new()
	# Not "Creature": the branch adopted UNDER it is called that, and two nodes of the
	# same name one inside the other made every path in the tests read twice.
	beast.name = "Walker"
	beast.set_script(CREATURE)
	piece.add_child(beast)
	_creature = beast
	return piece


func _the_goat() -> Node4D:
	var piece := Node4D.new()
	piece.name = "GoatStand"
	_table.add_child(piece)
	var goat := Node4D.new()
	goat.name = "Goat"
	goat.set_script(GOAT)
	piece.add_child(goat)
	goat.position = Vector4(0.0, 0.0, 0.0, 0.0)
	_goat = goat
	return piece


func _demonstrate(which: int, t: float) -> void:
	# Every fraction below is a fraction of THIS moment's length, which is not the shared
	# pace for all of them.
	var span: float = _length(which)
	match which:
		0:
			# The handles first, then the finished animal turning through W.
			#
			# THE STAND TURNS, NOT THE GOAT. The goat's own basis carries the uniform scale
			# that fits it to this stage, and writing a rotation onto it threw that away -
			# the animal jumped to its authored size half way through the slide.
			if _goat == null:
				return
			_goat.call("set_markers_visible", t < span * 0.34)
			if t > span * 0.45:
				var sweep: float = sin((t - span * 0.45) * 0.55) * 0.95
				_pieces[0].basis = Basis4D.from_xw(sweep) * Basis4D.from_zw(sweep * 0.4)
		1:
			# THE BUILD, PLAYED BACK. Every stage was lofted during the arrival, so this is
			# a sequence of node swaps and costs nothing - which is the only reason it can
			# happen while somebody is watching. It assembles over the first two thirds and
			# reshapes over the last.
			var count: int = int(_goat.call("stage_count"))
			var step: int = mini(count - 1, int(floor(t / span * float(count))))
			if step != int(_goat.call("shown_stage")):
				_goat.call("show_stage", step)
				# The handle count climbs with it, so the figure beside the animal is
				# counting the thing you are watching arrive.
				_retell(1)
			_goat.call("set_markers_visible", step < int(_goat.call("first_morph_stage")))
		2:
			# THREE BEATS, AND THE CAMERA DOES NOT MOVE. A walk cycle is read side-on -
			# turning the drum under it would hide the one thing the slide is about - so
			# everything that changes here is the creature itself.
			#
			#   walk, dressed        the animal, doing the ordinary thing
			#   skin off             the handles and the eight foot targets, still walking
			#   dressed again, trot  then canter: same rig, no new data, a different gait
			#
			# set_gait is called every frame and is a no-op when the gait is already the
			# one asked for, so scrubbing backward and forward lands in the right one.
			if _creature == null:
				return
			_creature.call("show_rig", t > span * 0.31 and t < span * 0.60)
			if t > span * 0.84:
				_creature.call("set_gait", "canter_right")
			elif t > span * 0.62:
				_creature.call("set_gait", "trot")
			else:
				_creature.call("set_gait", "walk")
