[node name="AboutWall" type="Node" parent="GalleryRoom"]
script = ExtResource("4_text")
side = "w"
along = Vector2(-6.6, 6.6)
up = Vector2(1.3, 6.6)
kind = "lesson"
number = 1
title = "The engine's test cases"
subtitle = "Andrew's own test scenes, as specimens"
body = "Andrew (4Denthusiast) wrote the engine's voxel world: its generators, its edits, its dual contouring. These are his test scenes, cut out as specimens: his landscape with its ocean and caves, his caves on their own, his 24-cell. Sit at their benches and cut them."
code = "blue"
glow = 0.2

[node name="FieldSign" type="Node" parent="GalleryRoom"]
script = ExtResource("4_text")
side = "n"
along = Vector2(-4.4, 4.4)
up = Vector2(4.6, 6.4)
kind = "sign"
title = "THE FIELD"
subtitle = "ANDREW'S LANDSCAPE, GENERATED ROUND YOU"
glow = 0.3

[node name="LimitsWall" type="Node" parent="GalleryRoom"]
script = ExtResource("4_text")
side = "e"
along = Vector2(-6.6, 6.6)
up = Vector2(1.3, 6.6)
kind = "lesson"
number = 2
title = "What still fails"
subtitle = "Where the voxels need work, measured in this room"
body = "A cut thinner than a voxel vanishes, so the saw's blade is a voxel and a third. A surface through grid points frays: the warm 24-cell. A cut's new chunks are built in the frame they first show; this lab builds them on a worker thread (T at any bench shows both). Detail costs the fourth power: the ladder. And GDScript cannot read a voxel back, so the lab keeps its own copy."
code = "blue"
glow = 0.2

