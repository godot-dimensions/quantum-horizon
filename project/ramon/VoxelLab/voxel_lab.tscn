[node name="AboutWall" type="Node" parent="GalleryRoom"]
script = ExtResource("4_text")
side = "w"
along = Vector2(-6.6, 6.6)
up = Vector2(1.6, 6.6)
kind = "lesson"
number = 2
title = "The whole world"
subtitle = "All three layers, and a sea, at full size"
body = "Our generator stacks the land, the caves carved through it, and a sea filling everything below a plane, cut out of a world with no edges. The noise is four-dimensional, so every slice through W is a new coastline. Change its look, or cut it: the engine remeshes it as you go."
code = "blue"
glow = 0.2

[node name="FieldSign" type="Node" parent="GalleryRoom"]
script = ExtResource("4_text")
side = "n"
along = Vector2(-4.4, 4.4)
up = Vector2(4.6, 6.4)
kind = "sign"
title = "THE OPEN WORLD"
subtitle = "AN ISLAND OF OUR LANDSCAPE, IN THE OPEN SEA"
glow = 0.3

[node name="LayersWall" type="Node" parent="GalleryRoom"]
script = ExtResource("4_text")
side = "e"
along = Vector2(-6.6, 6.6)
up = Vector2(2.4, 6.6)
kind = "lesson"
number = 1
title = "How a world is made"
subtitle = "One generator at a time"
body = "The engine builds land from generators, each a rule for what fills a voxel. First the land: fractal noise in bands of grass, dirt and stone. Then the caves: tunnels wherever three noise fields meet zero. Clip one by the other and the land is hollowed. Stack a sea under it and you have the world behind you."
code = "blue"
glow = 0.2

