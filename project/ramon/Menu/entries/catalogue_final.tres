[sub_resource type="Resource" id="Resource_penhr"]
script = ExtResource("1_i2ljj")
title = "The World"
blurb = "Every system on this menu, together in one open 4D world"
maturity = "Playable"
also_answers = PackedStringArray()
duration = "10 min"
detail = "Here the experiments stop being experiments. One valley holds them all at once: slices you read and turn, steps through W, aiming across slices, 4D trees and animals, a flock of 5,000 starlings. Around them, a world to explore: researchers at work, a cave whose far room lies out along W, a camera for 4D photographs, and Trym's talk in the cinema."
