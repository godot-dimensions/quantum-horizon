[sub_resource type="Resource" id="Resource_3ffix"]
script = ExtResource("1_i2ljj")
title = "Voxel Lab"
blurb = "4D rock you cut, bricks you build, a world you fly over"
category = "World systems"
family = "The labs"
thrust = "Build it"
world_link = "the cave's Artifact block, on the older voxel code"
also_answers = PackedStringArray()
detail = "An exhibition of our engine's own 4D voxels: a shelf of specimens, a block you cut by hand with every cut running through W, a builder where bricks laid in one W layer are gone from the next, and a gallery of how our world's land and caves are made. Through the far door, an open island to walk and fly over."
clip = "voxel_lab"
icon = ExtResource("bold_voxel")
preview_focus = 0.73
scene_path = "res://ramon/VoxelLab/voxel_lab.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "LMB", "Wheel", "RMB", "O")
control_actions = PackedStringArray("walk", "about this specimen", "step through W", "turn the slice", "the open world")
question = "Can 4D voxels be cut and built on live, at the speed of play?"
approach = "The engine's voxels, meshed in C++. Our change builds each cut's draw buffers on a worker thread."
finding = "The worst frame after a cut fell from 96 ms to 14 ms; a cut still lands 100 to 250 ms after the click."
finding_tier = "Measured"
benchmark = "Worst frame after a cut, median of 10: 96 ms before, 14 ms after · the open world: 1.6 million tetrahedra, built in 6.4 s"

[sub_resource type="Resource" id="Resource_clab"]
script = ExtResource("1_i2ljj")
title = "Creature Lab"
blurb = "One animal built on a pedestal, then a hall of 4D animals"
category = "Living systems"
family = "The labs"
thrust = "Fill it"
world_link = "the chickens, the wolf raid, the cinema's goat"
also_answers = PackedStringArray("Build it")
detail = "The first room builds one 4D animal in five steps: balls, skin, slice, rig and walk. Pick the goat, the chicken or the wolf and step through each. Through the far door, the creature hall: a brachiosaurus, a horse, a wolf, a heron, an owl, crows, chickens and more on their own decks, with other animals standing on the same decks further through W."
clip = "creature_lab"
icon = ExtResource("bold_creature")
preview_focus = 0.5
scene_path = "res://ramon/CreationLab/creature_lab.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "1 to 3", "LMB", "Wheel", "RMB")
control_actions = PackedStringArray("walk", "pick an animal", "next part", "step through W", "turn the slice")
question = "Can one room show how our 4D creatures are built and animated, the same way for any animal?"
approach = "Each animal is lofted from a handful of 4D balls into one skin, cut into rigid pieces and walked by one shared gait."
finding = "Lofting a whole animal takes 160 to 180 ms; walking its rigid pieces costs under 0.05 ms a frame."
finding_tier = "Measured"
benchmark = "Whole loft: goat 175.6 ms, chicken 168.6 ms · walking their rigid pieces: 0.016 and 0.040 ms a frame"

[sub_resource type="Resource" id="Resource_ph57d"]
script = ExtResource("1_i2ljj")
title = "Botany Lab"
blurb = "One 4D tree built four ways, then two worlds side by side"
section = "Lab"
category = "World systems"
family = "The labs"
thrust = "Fill it"
world_link = "the oaks, and the red oak on the Watchstone"
also_answers = PackedStringArray("Build it")
detail = "One 4D tree skeleton built four ways on four pedestals: blocky cells, smooth voxels, lofted branches, and an oak that grows branch by branch into 77,000 leaves. Each pedestal tells its story and shows what its method costs. Through the back door, two voxel worlds side by side: the same hills built blocky and smooth."
clip = "botany_lab"
icon = ExtResource("bold_botany")
preview_focus = 0.4
scene_path = "res://ramon/Arboretum/botany_lab.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "Wheel", "RMB", "E", "G")
control_actions = PackedStringArray("walk", "step through W", "turn the slice", "use", "gust of wind")
question = "Which way of building a 4D tree reads as a tree, and what does each one cost?"
approach = "One skeleton, four methods, and one wind read from the skeleton that moves them all."
finding = "In 4D a tree's skin is a volume, so voxel trees grow costly fast. The lofted one needs half the tetrahedra."
finding_tier = "Measured"
benchmark = "Blocky 147,290 tetrahedra · smooth 212,340 · lofted 70,504 · the oak 131,972, with 76,762 leaves in 0.8 ms"

[sub_resource type="Resource" id="Resource_aquatic"]
script = ExtResource("1_i2ljj")
title = "Aquatic Lab"
blurb = "A 4D aquarium you turn through W, and the sea beyond its door"
category = "World systems"
family = "The labs"
thrust = "Fill it"
also_answers = PackedStringArray()
detail = "A tank room 7 m deep in W: koi, an eel, a crab, a hammerhead and a reef. Step onto the blue square to turn the tank's contents through W and bring in fish that live beside your slice, and feed the koi by the glass. Through the exit door, the sea: a pier and platform, 3,000 sardines, gulls, boats and a visiting plesiosaur."
clip = "aquatic_lab"
icon = ExtResource("bold_aquatic")
preview_focus = 0.5
scene_path = "res://ramon/WaterLab/water_lab.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "RMB", "Wheel", "E", "R")
control_actions = PackedStringArray("walk", "turn the tank through W", "turn it front to back", "feed the koi", "whole again")
question = "Can 4D water and the life in it be shown, when the renderer draws only solid surfaces?"
approach = "The tank's water is drawn per pixel as a 4D box; each fish is a 4D body cut by your slice; the sea's waves run through W too."
finding = "The open sea costs a 3.29 ms median frame on its platform, just over our 3 ms target."
finding_tier = "Measured"
benchmark = "The sea, on the platform: 3.29 ms median, 4.01 ms at the 95th percentile, 1.82 ms on the graphics card · the reef: 325,000 tetrahedra"

[sub_resource type="Resource" id="Resource_fmw2o"]
script = ExtResource("1_i2ljj")
title = "Shooting Range"
blurb = "Hunt targets that hide in slices you cannot see"
maturity = "Playable"
category = "Spatial interaction"
family = "The experiments"
thrust = "Live it"
world_link = "the range, north of the gate"
also_answers = PackedStringArray("Build it")
duration = "9 min"
detail = "Targets that sit in slices you cannot see. Find them on the radar, step or turn your slice to reach them, then choose the shot: quick for red, charged for amber. Six rounds of four stages each, from finding a core in W to chickens that fly through it and a wolf that runs out of your slice."
clip = "shooting_range"
icon = ExtResource("bold_shooting_range")
preview_focus = 0.5
scene_path = "res://ramon/QuantumRange/quantum_range_final.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "LMB", "Q / E", "RMB", "F")
control_actions = PackedStringArray("walk", "shoot / hold to charge", "step through W", "turn the slice", "start")
question = "What does aiming mean when a target can leave your slice?"
approach = "A shot only hits what your slice cuts; the radar shows how far through W each target sits."
finding = "You can miss in a direction you cannot see, and it still reads as fair."
benchmark = "Our bot clears all six rounds under par · one 4D raycast: 12 to 16 µs · 1.3 to 1.5 ms a frame"

[sub_resource type="Resource" id="Resource_maze"]
script = ExtResource("1_i2ljj")
title = "The Maze"
blurb = "A maze in x, z and W, solved by turning what is ahead into W"
maturity = "Playable"
category = "Orientation"
family = "The experiments"
thrust = "Live it"
also_answers = PackedStringArray()
detail = "A maze whose corridors run along x, z and W, so every view of it is a flat maze. Press F and what lay ahead becomes W, with the hidden corridors in front of you; Q and E step through W, slowly and blind. Six levels, each adding one idea, from a single step to a generated cube, and an overlook to read each maze from above."
clip = "the_maze"
icon = ExtResource("bold_maze")
preview_focus = 0.5
scene_path = "res://ramon/PhaseMazeRemake/phase_maze_remake.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "F", "Q / E", "V")
control_actions = PackedStringArray("walk", "turn the slice a quarter", "step through W", "first or third person")
question = "Can players find their way in a space with a fourth direction, and does their map of it survive a turn?"
approach = "A real 4D maze: a turn shows you W, a step through it is slow and blind. Each level has a par of W moves."
finding = "Not yet played by people. Our bot solves all six levels at par, in 11 to 101 s a level."
finding_tier = "Not yet tested"
benchmark = "Bot at par on all six levels: 32, 11, 16, 41, 33 and 101 s · each level builds in 10 to 42 ms · 1.0 to 2.3 ms a frame"

[sub_resource type="Resource" id="Resource_annex"]
script = ExtResource("1_i2ljj")
title = "The Annex"
blurb = "A first-person walk through W in the dark: doors open as you shift, and the Tall Ones only see their own slice"
maturity = "Playable"
category = "Orientation"
family = "The experiments"
thrust = "Live it"
also_answers = PackedStringArray()
detail = "The Phase Maze remade a second time, first person, in the dark. Hold E or Q and you move through W at walking pace while the building rearranges itself round you: door leaves slide apart, walls sink into the floor, bridges grow out of the dark. Tall grey figures stand in some rooms. Each lives in one slice; if one sees you, its eyes go red and it walks to you, and the way out is another slice. Three levels: a door through W, an archive with an ambush, and the Heart, a vault you reach only by turning your view into W. Six logs tell what sleeps there."
clip = "the_annex"
icon = ExtResource("bold_annex")
preview_focus = 0.5
scene_path = "res://ramon/MazeRemake2/maze_remake_2.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD + MOUSE", "Q / E", "V", "RMB DRAG", "B")
control_actions = PackedStringArray("walk and look", "move through W", "finish a reveal", "turn into W (level 3)", "dark or bright")
question = "With no lesson first, does moving through W feel like moving somewhere, and can people find their way by it?"
approach = "W is a position you move along at walking pace. Every wall and door is a 4D solid whose cut changes smoothly with W, and the floor's colour is your W."
finding = "Not yet played by people. Our bot plays all three levels through the real keys, start to end card, every relic taken, past every Tall One."
finding_tier = "Not yet tested"
benchmark = "Bot checks: level 1 16 of 16, level 2 19 of 19, level 3 23 of 23, the Tall Ones 19 of 19 · 1.0 ms a frame in level 1, 1.6 ms in level 2, 3.1 ms in level 3"

