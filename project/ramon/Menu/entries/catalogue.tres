[sub_resource type="Resource" id="Resource_uy7oo"]
script = ExtResource("1_i2ljj")
title = "Slice Vision"
blurb = "Camera and avatar tuned for reading a 4D cross-section"
maturity = "Playable"
duration = "90 sec a level"
detail = "Three chambers that teach reading a cross-section before asking anything of you."
clip = "slice_vision"
icon = ExtResource("2_wp3od")
preview_focus = 0.64
scene_path = "res://ramon/MiegakureLook/levels/level_1_wall.tscn"
launch_label = "LEVEL 1 · WALL"
extra_launch_labels = PackedStringArray("LEVEL 2 · BRIDGE", "LEVEL 3 · DETOUR")
extra_launch_scenes = PackedStringArray("res://ramon/MiegakureLook/levels/level_2_bridge.tscn", "res://ramon/MiegakureLook/levels/level_3_detour.tscn")
control_keys = PackedStringArray("WASD", "RMB")
control_actions = PackedStringArray("move", "rotate slice 90°")
question = "Can anyone read a 4D scene at all without training?"
approach = "Third-person diorama, discrete 90° turns, floor banded along w."
finding = "Banding is load-bearing; an unbanded rotated view is a blank diamond."
benchmark = "6 / 6 / 5 scripted checks across the three levels · 90° turn eased over 0.7 s"

[sub_resource type="Resource" id="Resource_3f7jf"]
script = ExtResource("1_i2ljj")
title = "Phase Maze"
blurb = "Walls you pass by stepping through w, not by walking round them"
maturity = "Playable"
section = "Lab"
duration = "2 min"
detail = "A maze whose gates are open only in a narrow band of w, so the route exists only at the right depth."
clip = "phase_maze"
icon = ExtResource("3_boe22")
preview_focus = 0.5
scene_path = "res://ramon/PhaseMaze/phase_maze.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "Q / E")
control_actions = PackedStringArray("move", "through w")
question = "Can moving through w work as a navigation verb?"
approach = "A single-path maze whose three gates each open in a 3 m band of w."
finding = "It reads immediately, but only where the route is signposted."
benchmark = "3 gates, at w −6, 2 and 7 · each open for 3 m of w · walls 0.4 m thick in z"

[sub_resource type="Resource" id="Resource_snm5f"]
script = ExtResource("1_i2ljj")
title = "4D Ascent"
blurb = "An obstacle course you cross by stepping through w as much as by jumping"
maturity = "Greybox"
duration = "2 min"
detail = "A runway with a gap too wide to jump. The bridge across it exists only in one band of w, and the course goes on over a ramp, a lift and a braid of two paths."
clip = "ascent"
icon = ExtResource("4_lnafe")
preview_focus = 0.7000000000000001
scene_path = "res://ramon/ObstacleCourse/w_gap.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "SPACE", "Q / E")
control_actions = PackedStringArray("move", "jump", "through w")
question = "Can moving through w carry a platforming course?"
approach = "Ground banded in colour along w, so leaving a band shows under your feet."
finding = "Collision is boxes only, so a ramp is a slope drawn over hidden steps."
benchmark = "Gap 7 m against a 4.59 m jump, so it cannot be crossed until w changes · bridge at w 5"

[sub_resource type="Resource" id="Resource_d6obk"]
script = ExtResource("1_i2ljj")
title = "Portal"
blurb = "Blast a hole in a wall, and step through to somewhere else"
maturity = "Prototype"
duration = "2 min"
detail = "Two tests. A chamber of linked openings that carry your momentum across, and a wall you can shoot openings through anywhere."
clip = "portal"
icon = ExtResource("5_rlsh1")
preview_focus = 0.5
scene_path = "res://ramon/Portal/portal_test_2.tscn"
launch_label = "TEST 2 · PORTALS"
extra_launch_labels = PackedStringArray("TEST 1 · WALL")
extra_launch_scenes = PackedStringArray("res://ramon/Portal/portal_test_1.tscn")
control_keys = PackedStringArray("LMB", "F", "RMB")
control_actions = PackedStringArray("shoot / blue portal", "yellow portal", "rotate slice")
question = "Does Portal's momentum-preserving link survive four dimensions?"
approach = "Chunked voxel walls cut anywhere; two apertures carrying position, orientation and velocity."
finding = "Within one slice, yes. Both ends still share a w, and openings are opaque."
benchmark = "40.5 ms per chunk rebuild · 10,752 tetrahedra · 7.7 → 22.2 m/s over five crossings"

[sub_resource type="Resource" id="Resource_fmw2o"]
script = ExtResource("1_i2ljj")
title = "Quantum Range"
blurb = "Hitscan raycasting against 4D colliders"
maturity = "Playable"
duration = "2 min"
detail = "A range where targets can leave your slice entirely, so aiming is four-dimensional."
clip = "quantum_range"
icon = ExtResource("6_13old")
preview_focus = 0.73
scene_path = "res://ramon/ShootingGalleryRamon/shooting_gallery_ramon.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "LMB", "RMB")
control_actions = PackedStringArray("move", "fire", "rotate slice")
question = "What does aiming mean when a target can leave your slice?"
approach = "Real 4D raycasts against 4D collision, independent of the camera."
finding = "You can miss in a direction you cannot see - and it reads as fair."
benchmark = "True 4D raycasts against 4D colliders, independent of the camera"

[sub_resource type="Resource" id="Resource_3ffix"]
script = ExtResource("1_i2ljj")
title = "Voxel Mining"
blurb = "Destructible geometry by dual contouring in four dimensions"
maturity = "Prototype"
duration = "2 min"
detail = "A rock made of 4D voxels that you can carve into, re-meshed on every hit. Carve a crater, then step through w and watch it change."
clip = "voxel_mining"
icon = ExtResource("7_h1wdl")
preview_focus = 0.73
scene_path = "res://ramon/VoxelMining/voxel_mining_final_2.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "LMB", "Q / E")
control_actions = PackedStringArray("move", "carve", "through w")
question = "Can 4D matter be destroyed at interactive rates?"
approach = "Persistent voxel field, dual contoured, re-meshed per hit."
finding = "Yes at hand-held scale: each hit re-meshes the rock while you watch."
benchmark = "Not yet timed on this rock · the same carve on the Portal chamber's panels: ~130 ms a hit, ~58 fps"

[sub_resource type="Resource" id="Resource_ph57d"]
