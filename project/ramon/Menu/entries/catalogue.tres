[sub_resource type="Resource" id="Resource_clab"]
script = ExtResource("1_i2ljj")
title = "Creation Lab"
blurb = "How a 4D creature is built from balls and brought to life, one bay at a time"
maturity = "Prototype"
section = "Lab"
duration = "10 min, or 4 to watch"
detail = "Eleven bays stacked along W and ridden by a lift: lofting first, then the pieces, the feet, gaits, views, costs and layers, and a hall with every animal in the lab. Bright by default, B for the dark look."
clip = "creation_lab"
icon = ExtResource("8_jn372")
preview_focus = 0.5
scene_path = "res://ramon/CreationLab/creation_lab.tscn"
launch_label = "GUIDED"
extra_launch_labels = PackedStringArray("WATCH", "EXPLORE")
extra_launch_scenes = PackedStringArray("res://ramon/CreationLab/creation_lab_watch.tscn", "res://ramon/CreationLab/creation_lab_explore.tscn")
control_keys = PackedStringArray("WASD", "N", "M", "B")
control_actions = PackedStringArray("walk", "ride the lift", "every floor", "bright / dark")
question = "Can one walk through explain how our 4D creatures are built and animated, without overwhelming anyone?"
approach = "One idea per bay, one task to try, then a card with the method, its limits and what was measured. The bays stand one lift ride apart in W."
finding = "Lofting the whole wolf takes 164 ms, so the animals move rigid pieces instead: 0.92 ms a frame for the wolf, against 12.6 ms to re-loft a single leg every frame."
finding_tier = "Measured"
benchmark = "17 animals · 11 bays and a hall · under 2.3 ms a frame in every bay, 3.1 ms in the hall, 1280x720"

[sub_resource type="Resource" id="Resource_0k6x8"]
script = ExtResource("1_i2ljj")
title = "Motion Lab"
blurb = "A creature that walks without a single baked animation"
maturity = "Greybox"
section = "Lab"
duration = "2 min"
detail = "A quadruped whose gait is solved every frame from IK, with limb count and segments changeable live. It starts standing still: press 0."
clip = "creature"
icon = ExtResource("8_jn372")
preview_focus = 0.22
scene_path = "res://sandbox/limb_prototype/limb_prototype_treadmill.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("1 2 4 5", "0", "K / L", "N / M")
control_actions = PackedStringArray("gait", "start / stop", "limbs", "segments")
question = "Can a creature animate convincingly with no baked clips at all?"
approach = "FABRIK limbs, a gait state machine and hip suspension, solved every tick."
finding = "Limb count and proportions fall out of parameters, so a new creature needs no rig."
benchmark = "4 gaits · limbs and segments per limb changed live · per-foot ground raycast"

[sub_resource type="Resource" id="Resource_lofty"]
script = ExtResource("1_i2ljj")
title = "Lofted Creatures"
blurb = "Animals modelled by lofting through 4D, walking on procedural solvers"
maturity = "Prototype"
duration = "60 sec"
detail = "Five chickens, a brachiosaurus and Trym's rigged creature, every one modelled with the loft tool, all walking at once with no baked animation."
clip = "lofted_creatures"
icon = ExtResource("8_jn372")
scene_path = "res://ramon/Model/rigged_creature_ramon.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "RMB", "Q / E")
control_actions = PackedStringArray("move", "rotate slice", "through w")
question = "Can one modelling tool make creatures that walk in 4D?"
approach = "Bodies lofted from balls along a spine; legs and neck moved by IK and gait solvers."
finding = "Geometry is nearly free; deformation is the whole cost."
finding_tier = "Measured"
benchmark = "~25 ms a frame, seven creatures walking · 73,020 tetrahedra drawn in 1.2 ms · one machine, 19 Sep"

[sub_resource type="Resource" id="Resource_penhr"]
script = ExtResource("1_i2ljj")
title = "Chicken Pen"
blurb = "A small 4D world: bring nine loose chickens home"
maturity = "Playable"
duration = "about 10 min"
detail = "A farm with a keeper, a cave with a secret along w, a shooting range and Trym's talk in the cinema. About ten minutes to learn, an hour to see everything."
clip = "chicken_pen"
scene_path = "res://ramon/chickenpen/playable_world.tscn"
launch_label = "PLAY THE WORLD"
opens_as_scene = true
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "E / Q", "RMB", "F")
control_actions = PackedStringArray("move", "through w", "turn the slice", "pick up, talk")
question = "Can 4D carry a whole game loop, not only a test chamber?"
approach = "An open farm with a fetch quest, dialogue, mining and a range, all on the one 4D module."
finding = "A room in 4D needs eight walls, not six, or it opens when the slice turns."
benchmark = "2.46 ms a frame with 862 meshes and nine animated chickens · RTX 5080, editor build, 28 Sep"

[sub_resource type="Resource" id="Resource_film1"]
script = ExtResource("1_i2ljj")
title = "Flight of the 4D Starlings"
blurb = "A murmuration of 5,000 starlings at dusk, filmed live in the pen"
maturity = "Polished"
section = "Cinematic"
duration = "55 sec"
detail = "Six shots of the flock over the chicken pen: from the farm, underneath, alongside, inside it, a hawk diving through at half speed, and a step along W. It plays live in the pen rather than from a recording, so the numbers in the first shot are the flock's own."
icon = ExtResource("icon_film1")
scene_path = "res://ramon/chickenpen/playable_world.tscn"
launch_label = "WATCH"
opens_as_scene = true
cinematic = "murmuration"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("ESC")
control_actions = PackedStringArray("skip to the end")
question = "Can thousands of 4D bodies move as one, live, inside a playable scene?"
approach = "Reynolds boids on a GPU compute shader: seven nearest neighbours each, turning inertia, a roost and a hawk, drawn as one multimesh in the 4D renderer's own pass."
finding = "Turning inertia is what carries a turn across the flock: plain boids reached 5% of 300 birds and faded, 0.05 s of inertia carried it across 61% without fading."
finding_tier = "Measured"
benchmark = "5,000 birds 0.38 ms a frame, 0.79 ms after a hawk · RTX 5080, 1280x720, 1 Oct"

