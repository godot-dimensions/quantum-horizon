[sub_resource type="Resource" id="Resource_0k6x8"]
script = ExtResource("1_i2ljj")
title = "Motion Lab"
blurb = "A creature that walks without a single baked animation"
duration = "2 min"
detail = "A quadruped whose gait is solved every frame from IK, with limb count and segments changeable live."
clip = "creature"
icon = ExtResource("8_jn372")
preview_focus = 0.22
scene_path = "res://sandbox/limb_prototype/limb_prototype_treadmill.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("1 – 5", "K / L", "N / M")
control_actions = PackedStringArray("gait", "limbs", "segments")
question = "Can a creature animate convincingly with no baked clips at all?"
approach = "FABRIK limbs, a gait state machine, hip suspension and spine IK, solved per tick."
finding = "Limb count and proportions fall out of parameters, so a new creature needs no rig."
benchmark = "5 gaits · limbs and segments per limb changed live · per-foot ground raycast"

[sub_resource type="Resource" id="Resource_3ffix"]
script = ExtResource("1_i2ljj")
title = "Voxel Mining"
blurb = "Destructible geometry by dual contouring in four dimensions"
duration = "2 min"
detail = "A rock made of 4D voxels that you can carve into, re-meshed on every hit."
clip = "voxel_mining"
icon = ExtResource("7_h1wdl")
preview_focus = 0.73
scene_path = "res://ramon/VoxelMining/voxel_mining_final_2.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "LMB", "Q / E")
control_actions = PackedStringArray("move", "carve", "through w")
question = "Can 4D matter be destroyed at interactive rates?"
approach = "Persistent voxel field, dual contoured, re-meshed per hit."
finding = "Yes: about 130 ms per carve at room scale, around 58 fps."
benchmark = "~130 ms per carve at room scale · ~58 fps · 10,752 tetrahedra"

[sub_resource type="Resource" id="Resource_3f7jf"]
script = ExtResource("1_i2ljj")
title = "Phase Maze"
blurb = "Walls you pass by rotating, not by walking"
maturity = "Playable"
duration = "2 min"
detail = "A maze whose walls occupy bands of w, so the route exists only at the right slice."
clip = "phase_maze"
icon = ExtResource("3_boe22")
preview_focus = 0.5
scene_path = "res://ramon/PhaseMaze/phase_maze.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "RMB", "Q / E")
control_actions = PackedStringArray("move", "rotate slice", "through w")
question = "Does rotation work as a navigation verb rather than a camera trick?"
approach = "Maze walls occupy w-bands; rotating changes which ones are solid."
finding = "It reads immediately, but only where the route is signposted."
benchmark = "2 levels · walls 0.4 m thick in z · slice rotation on right mouse"

[sub_resource type="Resource" id="Resource_ph57d"]
script = ExtResource("1_i2ljj")
title = "Shrubbery Forest"
blurb = "Trees grown in four dimensions, competing for the same space"
duration = "90 sec"
detail = "Thirty trees grown by space colonisation, each confined to its own cell so canopies never touch."
clip = "shrubbery"
icon = ExtResource("9_ajynb")
preview_focus = 0.4
scene_path = "res://sandbox/shrubbery/shrubbery_forest.tscn"
extra_launch_labels = PackedStringArray()
extra_launch_scenes = PackedStringArray()
control_keys = PackedStringArray("WASD", "RMB", "G")
control_actions = PackedStringArray("move", "rotate slice", "new forest")
question = "Does procedural growth still read as botanical once it grows in 4D?"
approach = "Space colonisation per tree, clipped to its Voronoi cell and eroded for crown shyness."
finding = "No Voronoi diagram is ever built - the nearest-site test generalises to 4D for free."
benchmark = "623,007 voxels · 8,352,790 tetrahedra · 2.83 s to grow 30 trees"

[sub_resource type="Resource" id="Resource_d6obk"]
script = ExtResource("1_i2ljj")
title = "Portal"
blurb = "Blast a hole in a wall, and step through to somewhere else"
duration = "2 min"
detail = "Two tests. One wall you can shoot openings through anywhere, cumulatively; one chamber of linked openings that carry your momentum across."
clip = "portal"
icon = ExtResource("5_rlsh1")
preview_focus = 0.5
scene_path = "res://ramon/Portal/portal_test_1.tscn"
launch_label = "TEST 1 · WALL"
extra_launch_labels = PackedStringArray("TEST 2 · PORTALS")
extra_launch_scenes = PackedStringArray("res://ramon/Portal/portal_test_2.tscn")
control_keys = PackedStringArray("LMB", "F", "RMB")
control_actions = PackedStringArray("shoot / blue portal", "yellow portal", "rotate slice")
question = "Does Portal's momentum-preserving link survive four dimensions?"
approach = "Chunked voxel walls cut anywhere; two apertures carrying position, orientation and velocity."
finding = "Both hold: cuts merge cumulatively, and crossings accelerate 7.7 to 22.2 m/s."
benchmark = "40.5 ms per chunk rebuild · 10,752 tetrahedra · 7.7 → 22.2 m/s over five crossings"

[sub_resource type="Resource" id="Resource_uy7oo"]
script = ExtResource("1_i2ljj")
title = "Slice Vision"
blurb = "Camera and avatar tuned for reading a 4D cross-section"
maturity = "Playable"
duration = "90 sec"
