[resource]
script = ExtResource("1_info")
number = 5
title = "Aquatic Lab"
status = "THE TANK  /  THE FISH  /  THE SEA"
lead = "A tank, a sea and their life, in four dimensions."
description = "A tank 7 m deep in W. Its water is drawn per pixel against the tank as a 4D box, and its {koi} koi, its eel, crab and hammerhead swim through W: a few live off your slice. Stand on the blue circle and right-drag to find them, or feed the koi at the console. The door at the far end opens onto the sea."
interactions = [["key:E", "Feed the koi"], ["rdrag", "Turn the slice (blue circle)"], ["wheel", "The showcase through W"], ["key:R", "Level the slice"]]
controls_heading = "CONTROLS"
research_title = "HOW THE WATER AND THE FISH WORK"
research_status = "●  MEASURED LIVE ON THIS MACHINE"
research_layout = "specimen"
