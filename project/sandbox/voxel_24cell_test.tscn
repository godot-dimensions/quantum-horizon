[node name="Node4D" type="Node4D"]
editor_description = "This is a test of a case where the current voxel meshing algorithm is known to behave poorly. The edges of the 24-cells pass through the voxel grid points, so it must arbitrarily choose which of the multiple relevant surface normals to use, and if it chooses badly, the mesh ends up with spurious fringes around the edges. The same geometry, if aligned slightly differently, is handled much better."
script = ExtResource("1_tester")

