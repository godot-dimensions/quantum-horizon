class_name TerrainMeshBackendMT
extends RefCounted
## Marching Tetrahedra ("marching 4-simplices")-backed implementation of
## VoxelWorld4D's brick meshing interface - same swappable-static-interface
## contract as TerrainMeshBackendDC (see that file's own header for why the
## interface exists), swapped in as the live backend after a correctness
## investigation found DC is NOT watertight at any tested resolution
## (~23-43% singly-referenced/"hole" faces across 6 independent test
## cases spanning tiny/full-scale/clean-control inputs - the well-
## documented dual-contouring non-manifold problem, not one patchable
## bug), while this algorithm measured EXACTLY 0.0% unpaired faces at
## every resolution tested, including the coarse, production-realistic
## grid sizes this brick system actually uses (6^4, matching
## ACTUAL_POINTS_PER_AXIS below). DualContour4D/generate_native() and
## TerrainMeshBackendDC are left in place, unreferenced by VoxelWorld4D,
## as the trusted prior implementation - not deleted.
##
## Algorithm: standard Kuhn/Freudenthal cube triangulation, generalized to
## 4D - each 16-corner tesseract cell splits into 4! = 24 four-simplices,
## every one anchored at the SAME local corner (0000) for EVERY cell.
## Deliberately NOT alternated/checkerboarded per cell: that variant was
## tried specifically to reduce the algorithm's visually regular facet
## pattern and FAILED the crack test outright (~34% unpaired faces on
## both tested cases) - two different-anchor triangulations don't agree
## on how to split their shared face, reproducing the exact "independent
## per-cell diagonal choice" failure mode that breaks DC. Only the single,
## always-identical-per-cell scheme is proven watertight; do not
## reintroduce per-cell variation here without re-running that exact
## crack test first.
##
## Each 5-corner simplex is classified by how many of its corners are
## "solid" (negative density): 0 or 5 -> no crossing, skipped entirely;
## 1 or 4 -> the minority corner is cut off, its 4 crossing points to the
## other 4 corners form one tetrahedron; 2 or 3 -> the corners split into
## a 2-group and a 3-group, whose 2*3=6 crossing points form a triangular
## prism, split into 3 tetrahedra by a fixed decomposition.
##
## Crossing points are exact linear interpolations between two GLOBAL grid
## corners - _get_or_add_crossing_vertex canonicalizes the lerp order by
## global index (lower index first), NOT by which corner a given simplex
## locally treated as the minority side, so two different simplices -
## even in DIFFERENT bricks generated by separate generate_brick_mesh()
## calls - land on a bit-identical shared-boundary position. This, not
## welding (a separate, purely space-saving optimization applied on top),
## is the actual reason this algorithm is crack-free.

const BIT_FOR_AXIS := [8, 4, 2, 1]  # matches ci = bi*8 + bj*4 + bk*2 + bl (x,y,z,w)

## A cell's own tets are fully determined by that ONE cell's 16 corners -
## no neighboring cell is ever consulted, unlike DC's dual-cube tet
## assembly which does reach into adjacent dual vertices. The only reason
## for any apron at all here is ownership filtering: a cell straddling the
## nominal/apron boundary still needs its own full 16-corner data even
## when some of those corners sample apron territory, and the deepest
## such cell reaches exactly 1 cell-width beyond the boundary - same
## value as DC's stencil_radius_cells(), for a different underlying
## reason. VoxelBrick4D.APRON_CELLS is a hardcoded 1, not dynamically
## read from either backend - this value must keep agreeing with it.
static func stencil_radius_cells() -> int:
	return 1

static func _permutations(n: int) -> Array:
	if n == 0:
		return [[]]
	var result := []
	var smaller: Array = _permutations(n - 1)
	for p in smaller:
		for i in range(p.size() + 1):
			var new_p: Array = p.duplicate()
			new_p.insert(i, n - 1)
			result.append(new_p)
	return result

## The Kuhn/Freudenthal triangulation anchored at local corner 0 (0000):
## monotone paths from corner 0 to its complement 15 (1111), one per
## permutation of the 4 axes - 24 simplices, 5 corner indices each.
## Recomputed per generate_brick_mesh() call rather than cached: a handful
## of microseconds against a call that does thousands of density
## evaluations, not worth any static-init caching risk.
static func _build_simplices() -> Array:
	var simplices := []
	for perm in _permutations(4):
		var corners := [0]
		var acc := 0
		for axis in perm:
			acc = acc ^ BIT_FOR_AXIS[axis]
			corners.append(acc)
		simplices.append(corners)
	return simplices

static func _get_or_add_crossing_vertex(gidx_a: int, pos_a: Vector4, d_a: float, gidx_b: int, pos_b: Vector4, d_b: float, out_positions: PackedVector4Array, edge_cache: Dictionary) -> int:
	var lo_gidx: int
	var hi_gidx: int
	var lo_pos: Vector4
	var hi_pos: Vector4
	var lo_d: float
	var hi_d: float
	if gidx_a <= gidx_b:
		lo_gidx = gidx_a
		lo_pos = pos_a
		lo_d = d_a
		hi_gidx = gidx_b
		hi_pos = pos_b
		hi_d = d_b
	else:
		lo_gidx = gidx_b
		lo_pos = pos_b
		lo_d = d_b
		hi_gidx = gidx_a
		hi_pos = pos_a
		hi_d = d_a
	var key := "%d_%d" % [lo_gidx, hi_gidx]
	if edge_cache.has(key):
		return edge_cache[key]
	var t: float = lo_d / (lo_d - hi_d)
	var pos: Vector4 = lo_pos.lerp(hi_pos, t)
	var idx: int = out_positions.size()
	out_positions.append(pos)
	edge_cache[key] = idx
	return idx

## Returns an Array of tets, each an Array of 4 welded vertex indices into
## out_positions (mutated in place).
static func _simplex_to_tets(sc: Array, corner_pos: Array, corner_density: Array, corner_gidx: Array, out_positions: PackedVector4Array, edge_cache: Dictionary) -> Array:
	var d := []
	var p := []
	var g := []
	for ci in sc:
		d.append(corner_density[ci])
		p.append(corner_pos[ci])
		g.append(corner_gidx[ci])
	var neg_indices := []
	var pos_indices := []
	for i in range(5):
		if d[i] < 0.0:
			neg_indices.append(i)
		else:
			pos_indices.append(i)
	var k: int = neg_indices.size()
	if k == 0 or k == 5:
		return []
	if k == 1 or k == 4:
		var minority: Array = neg_indices if k == 1 else pos_indices
		var majority: Array = pos_indices if k == 1 else neg_indices
		var iso: int = minority[0]
		var idxs := []
		for j in majority:
			idxs.append(_get_or_add_crossing_vertex(g[iso], p[iso], d[iso], g[j], p[j], d[j], out_positions, edge_cache))
		return [idxs]
	# k == 2 or k == 3: 2-group vs 3-group, 6 pairwise crossing points,
	# split into 3 tets via a triangular-prism decomposition. This is the
	# ALTERNATE diagonal choice (fan sharing diagonal group_a[1]-group_b[0]),
	# not the original fan-from-group_a[0]/group_b[2] diagonal - a reference-
	# geometry sweep (density-independent, neutral t=0.5 crossings on the
	# plain unit cube) found the ORIGINAL choice produces a genuinely
	# degenerate/near-zero-volume tet for EVERY simplex whenever group_a is
	# the two farthest-apart corners (local indices 0 and 4 - the anchor and
	# its complement, i.e. the main diagonal of the whole cube: 24/240
	# combinations, exactly one per simplex). This alternate diagonal
	# resolves every one of those AND has zero degenerate combinations
	# across the entire 240-combination sweep (vs the original's 24) - not
	# a targeted patch for the bad cases specifically, a strictly better
	# choice applied uniformly. Re-verified crack-free (0% unpaired faces)
	# after this change - see the investigation notes, since swapping which
	# valid decomposition is used is exactly the kind of change that broke
	# crack-freeness elsewhere in this investigation (the checkerboard-
	# parity experiment) when done incorrectly (there, by using DIFFERENT
	# SIMPLICES per cell; here, the same 24 simplices are unchanged, only
	# which internal diagonal splits each individual prism, uniformly).
	var group_a: Array = neg_indices if neg_indices.size() == 2 else pos_indices
	var group_b: Array = pos_indices if neg_indices.size() == 2 else neg_indices
	var vidx := []  # vidx[i][j] = welded vertex index between group_a[i] and group_b[j]
	for i in range(2):
		var row := []
		for j in range(3):
			var ai: int = group_a[i]
			var bj: int = group_b[j]
			row.append(_get_or_add_crossing_vertex(g[ai], p[ai], d[ai], g[bj], p[bj], d[bj], out_positions, edge_cache))
		vidx.append(row)
	var v00: int = vidx[0][0]
	var v01: int = vidx[0][1]
	var v02: int = vidx[0][2]
	var v10: int = vidx[1][0]
	var v11: int = vidx[1][1]
	var v12: int = vidx[1][2]
	return [
		[v00, v01, v02, v10],
		[v01, v02, v10, v11],
		[v02, v10, v11, v12],
	]

static func _dummy_source_ids(n: int) -> PackedInt32Array:
	var ids := PackedInt32Array()
	ids.resize(n)
	for i in range(n):
		ids[i] = i
	return ids

static func _sum_where(corner_density: Array, bitmask: int, invert: bool = false) -> float:
	var total := 0.0
	for ci in range(16):
		var has_bit: bool = (ci & bitmask) != 0
		if has_bit != invert:
			total += corner_density[ci]
	return total

## A pure coincident-vertex test (tried first) caught NONE of the tets the
## engine actually rejects - re-running with it active reproduced the
## identical crashes, unchanged. So the real mechanism isn't "two crossing
## points snap to the same corner" - it's 4 genuinely DISTINCT points that
## are (near-)coplanar, i.e. an actual zero-volume simplex, which only a
## real volume/conditioning test can catch. Reuses DualContour4D's
## _tet_condition() formula (scale-invariant: built from normalized edge
## directions, so it means the same thing regardless of world_step).
##
## Threshold: tried 1e-6 first (far tighter than DC's own 0.01) hoping to
## catch only near-exact mathematical zero - measurably fewer crashes, but
## NOT zero; some tets ConcaveMeshShape4D still rejects sit between 1e-6
## and 0.01. DC's own 0.01 is the only value confirmed (both windowed
## verify suites, zero engine errors) to eliminate every crash. It does
## skip visibly more of MT's tets than it would DC's (MT's fixed,
## non-adaptive single-anchor triangulation has a wider natural spread of
## conditioning values than DC's dual-cube-derived tets, so a uniform
## checkerboard-like thinning is visible in a dense showcase render) -
## this is a known, real quality trade-off, not a hidden one: functional
## correctness (no crashes, verify suites clean) takes priority over
## visual density here, matching this codebase's own stated policy for
## skipped_degenerate_tet_count ("leaves a tiny gap at worst"). A smarter
## per-cell mitigation (e.g. an adaptive alternate-anchor choice, DC-style)
## is a real follow-up - NOT the checkerboard-parity alternation already
## tried and rejected elsewhere in this investigation, which breaks crack-
## freeness outright.
const _DEGENERATE_CONDITION_THRESHOLD := 0.01

static func _is_degenerate_tet(p0: Vector4, p1: Vector4, p2: Vector4, p3: Vector4) -> bool:
	return _tet_condition(p1 - p0, p2 - p0, p3 - p0) <= _DEGENERATE_CONDITION_THRESHOLD

static func _tet_condition(edge1: Vector4, edge2: Vector4, edge3: Vector4) -> float:
	var len0 := edge1.length()
	var len1 := edge2.length()
	var len2 := edge3.length()
	if len0 < 1e-9 or len1 < 1e-9 or len2 < 1e-9:
		return 0.0
	var n01 := edge1.dot(edge2) / (len0 * len1)
	var n02 := edge1.dot(edge3) / (len0 * len2)
	var n12 := edge2.dot(edge3) / (len1 * len2)
	var c00 := 1.0 - n12 * n12
	var c01 := n02 * n12 - n01
	var c02 := n01 * n12 - n02
	var det := c00 + n01 * c01 + n02 * c02
	return det if is_finite(det) else 0.0

## `density_fn` must return the density at exactly the grid points
## `bounds_min + index*world_step` for index in [0, points_per_axis) per
## axis - in practice a brick's own VoxelBrick4D.stored_density_fn(), so
## edits (which mutate that stored array) are respected. world_step is
## used DIRECTLY (never re-derived by dividing a bounds span), matching
## DualContour4D.generate_native()'s own convention - the whole reason
## VoxelWorld4D threads one shared world_origin/step through every brick
## is bit-reproducible grid-point math across independently generated
## bricks, and re-deriving step by division would silently defeat that
## for this backend specifically.
static func generate_brick_mesh(bounds_min: Vector4, world_step: Vector4, points_per_axis: int, density_fn: Callable) -> Dictionary:
	var simplices := _build_simplices()
	var n1 := points_per_axis - 1
	var edge_cache := {}
	var out_positions := PackedVector4Array()
	var out_indices := PackedInt32Array()
	var out_normals := PackedVector4Array()
	# One entry per TET (not 4, unlike out_normals) - the cell's own known-
	# correct outward direction (solid -> air, from the density gradient),
	# assigned directly as this tet's ArrayTetraMesh4D boundary/front-face
	# normal. This is set explicitly (see VoxelWorld4D._build_brick_mesh) so
	# front-face determination never routes through
	# ArrayTetraMesh4D.calculate_boundary_normals()'s own "assume normal
	# points away from origin" heuristic - a heuristic documented to work
	# for convex shapes centered on the origin, but WRONG for an open,
	# non-convex terrain sheet that mostly doesn't enclose the origin at
	# all. That mismatch was confirmed to be the actual cause of a
	# checkerboard of missing/culled facets across the live terrain
	# (roughly half of exposed facets get the wrong front/back side from
	# the heuristic) - not a classification or bucketing bug, and not
	# specific to color banding (reproduced identically on the single
	# unsplit render mesh, no bands involved).
	var out_boundary_normals := PackedVector4Array()
	var out_degenerate_flags := PackedByteArray()
	var tet_count := 0
	var skipped_degenerate_tet_count := 0
	var phase1_usec := 0
	var total_t0 := Time.get_ticks_usec()

	for i in range(n1):
		for j in range(n1):
			for k in range(n1):
				for l in range(n1):
					var corner_density: Array = []
					corner_density.resize(16)
					var corner_pos: Array = []
					corner_pos.resize(16)
					var corner_gidx: Array = []
					corner_gidx.resize(16)
					for bi in range(2):
						var gi: int = i + bi
						for bj in range(2):
							var gj: int = j + bj
							for bk in range(2):
								var gk: int = k + bk
								for bl in range(2):
									var gl: int = l + bl
									var ci: int = bi * 8 + bj * 4 + bk * 2 + bl
									var pos := bounds_min + Vector4(gi * world_step.x, gj * world_step.y, gk * world_step.z, gl * world_step.w)
									corner_pos[ci] = pos
									var density_t0 := Time.get_ticks_usec()
									corner_density[ci] = density_fn.call(pos)
									phase1_usec += Time.get_ticks_usec() - density_t0
									corner_gidx[ci] = ((gi * points_per_axis + gj) * points_per_axis + gk) * points_per_axis + gl
					var min_d: float = corner_density[0]
					var max_d: float = corner_density[0]
					for d in corner_density:
						min_d = minf(min_d, d)
						max_d = maxf(max_d, d)
					if min_d >= 0.0 or max_d <= 0.0:
						continue  # uniform cell - no crossing anywhere inside it

					# One crude per-cell "normal" (central-difference gradient) -
					# the engine's Cross-section mesh builder currently ignores
					# per-vertex normals for shading entirely (confirmed in
					# tetra_mesh_4d.cpp - flat per-facet only), so this only
					# needs to exist and be roughly right, not be analytically
					# exact per welded vertex.
					var grad := Vector4(
						(_sum_where(corner_density, 8) - _sum_where(corner_density, 8, true)) / (8.0 * world_step.x),
						(_sum_where(corner_density, 4) - _sum_where(corner_density, 4, true)) / (8.0 * world_step.y),
						(_sum_where(corner_density, 2) - _sum_where(corner_density, 2, true)) / (8.0 * world_step.z),
						(_sum_where(corner_density, 1) - _sum_where(corner_density, 1, true)) / (8.0 * world_step.w)
					)
					var n: Vector4 = grad.normalized()
					if n.is_zero_approx():
						n = Vector4(0.0, 1.0, 0.0, 0.0)

					for sc in simplices:
						var tets: Array = _simplex_to_tets(sc, corner_pos, corner_density, corner_gidx, out_positions, edge_cache)
						for idxs in tets:
							var p0: Vector4 = out_positions[idxs[0]]
							var p1: Vector4 = out_positions[idxs[1]]
							var p2: Vector4 = out_positions[idxs[2]]
							var p3: Vector4 = out_positions[idxs[3]]
							# Canonicalize winding order against the KNOWN-correct
							# outward (solid -> air) direction `n`, mirroring
							# DualContour4D.generate()'s own established technique
							# (see its comment near its own perp/ref_normal swap) -
							# NOT for simplex_cell_boundary_normals (confirmed
							# unused by the Cross-section render shader, only
							# consumed by physics/raycast queries), but because
							# the shader's own cross-section triangle winding is
							# computed from RAW VERTEX ORDER via a fixed 16-case
							# lookup table (tetra_cross_section_shader.glsl), and
							# Godot's default back-face culling then silently
							# drops whichever triangles come out with the "wrong"
							# winding for their specific case. An inconsistent
							# vertex-order convention across tets (this backend's
							# combinatoric crossing-vertex construction has no
							# such convention built in) means roughly half of all
							# exposed facets get culled - this, not classification/
							# bucketing/boundary-normal-heuristic, was confirmed to
							# be the actual cause of the checkerboard-of-missing-
							# facets defect. Swapping the last two indices flips
							# the tet's intrinsic handedness without changing its
							# volume/shape/degeneracy.
							var perp := Vector4D.perpendicular(p1 - p0, p2 - p0, p3 - p0)
							if perp.dot(n) < 0.0:
								var tmp_idx: int = idxs[2]
								idxs[2] = idxs[3]
								idxs[3] = tmp_idx
								var tmp_p := p2
								p2 = p3
								p3 = tmp_p
							# Degenerate/near-zero-volume tets are NOT dropped
							# here anymore - only ConcaveMeshShape4D's own
							# closest-point-cache construction actually needs
							# them excluded ("degenerate or non-finite"); the
							# render mesh has no such constraint, and dropping
							# them there too was purely collateral, producing a
							# visible checkerboard of holes with no rendering
							# benefit. Flag instead of skip - VoxelWorld4D
							# builds two meshes from this data (see
							# _build_brick_mesh): the full one for display, a
							# flag-filtered one for collision only.
							var is_degenerate := _is_degenerate_tet(p0, p1, p2, p3)
							if is_degenerate:
								skipped_degenerate_tet_count += 1
							out_indices.append(idxs[0])
							out_indices.append(idxs[1])
							out_indices.append(idxs[2])
							out_indices.append(idxs[3])
							out_normals.append(n)
							out_normals.append(n)
							out_normals.append(n)
							out_normals.append(n)
							out_boundary_normals.append(n)
							out_degenerate_flags.append(1 if is_degenerate else 0)
							tet_count += 1

	var total_usec := Time.get_ticks_usec() - total_t0
	return {
		"unique_vertex_positions": out_positions,
		"tet_vertex_indices": out_indices,
		"tet_vertex_normals": out_normals,
		"tet_source_ids": _dummy_source_ids(tet_count),
		"tet_count": tet_count,
		"tet_boundary_normals": out_boundary_normals,
		"tet_degenerate_flags": out_degenerate_flags,
		"skipped_degenerate_tet_count": skipped_degenerate_tet_count,
		"phase1_usec": phase1_usec,
		"phase2_usec": maxi(0, total_usec - phase1_usec),
		"phase3_usec": 0,
	}
